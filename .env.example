# Optional hosted publishing with accounts (docs/HOSTED_PUBLISHING.md).
# These are SERVER-ONLY secrets: NEVER use NEXT_PUBLIC_ prefixes.
MOSSLINE_HOSTED_PUBLISHING_ENABLED=false
# Any Postgres. Add sslmode=require for hosted databases.
MOSSLINE_DATABASE_URL=
# At least 32 random characters: openssl rand -base64 48
MOSSLINE_AUTH_SECRET=
# The address people use, e.g. https://mossline.example.org
MOSSLINE_BASE_URL=
# Who may sign in and publish: addresses, @domains, or * for anyone.
MOSSLINE_PUBLISHERS=
# New maps per account per day (default 20).
MOSSLINE_PUBLISH_DAILY_LIMIT=
# Ways to sign in: set at least one.
MOSSLINE_MICROSOFT_CLIENT_ID=
MOSSLINE_MICROSOFT_CLIENT_SECRET=
# common (default), organizations, consumers or a tenant ID
MOSSLINE_MICROSOFT_TENANT=
MOSSLINE_GOOGLE_CLIENT_ID=
MOSSLINE_GOOGLE_CLIENT_SECRET=
MOSSLINE_EMAIL_FROM=
MOSSLINE_SMTP_URL=
# Tests only: write sign-in links to files here instead of emailing them.
MOSSLINE_TEST_MAIL_DIR=


# Optional Alpha 2 model-assisted discovery — deliberately disabled by default.
# Server-only: NEVER set these with a NEXT_PUBLIC_ prefix.
# Any OpenAI-compatible HTTPS base ending in /v1, e.g. a trusted model provider.
MOSSLINE_DISCOVERY_BASE_URL=
MOSSLINE_DISCOVERY_EMBEDDING_MODEL=
# Optional: required only for model-generated candidate explanations.
MOSSLINE_DISCOVERY_CHAT_MODEL=
MOSSLINE_DISCOVERY_API_KEY=
# Separate high-entropy (>=32 chars) operator code shared with approved alpha testers.
# Do not reuse the hosted-publication authorisation code.
MOSSLINE_DISCOVERY_ACCESS_KEY=
