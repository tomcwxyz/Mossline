{
  "name": "mossline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mossline/web",
    "build": "npm run build --workspace @mossline/web",
    "mcp": "npm run start --workspace @mossline/mcp",
    "test": "tsx --test packages/graph-core/test/*.test.ts apps/web/test/*.test.ts",
    "typecheck": "tsc -p packages/graph-core/tsconfig.json --noEmit && tsc -p apps/mcp/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate --workspace @mossline/web --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "topojson-simplify": "3.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "world-atlas": "2.0.2"
  }
}
